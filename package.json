{
  "name": "scopelock",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Turn client change requests into priced PayPal sandbox invoices, gate work on payment, and pay contractors.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "tsx --conditions=react-server --env-file-if-exists=.env scripts/paypal-smoke.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.79",
    "@svar-ui/react-gantt": "2.8.2",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "ai": "7.0.154",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
