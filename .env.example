# PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox)
# Leave both empty to run with the built-in PayPal simulator (clearly labelled in the UI).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_SDK_URL=https://www.sandbox.paypal.com/web-sdk/v6/core

# Sandbox accounts (fake, created in the PayPal developer dashboard)
DEMO_CLIENT_EMAIL=client@example.com          # personal sandbox account that pays invoices
DEMO_CONTRACTOR_EMAILS=designer@example.com,frontend@example.com,backend@example.com
# Shown to judges in the judge guide (sandbox buyer login, fake account)
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=

# AI: Google Gemini (key from aistudio.google.com). Leave empty to use the rule-based extractor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# App
DATABASE_PATH=./data/scopelock.db
PAYOUT_CAP_CENTS=500000
APP_BASE_URL=http://localhost:3000
